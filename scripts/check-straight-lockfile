#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
lock="$root/straight/versions/default.el"

if [ ! -f "$lock" ]; then
  echo "No lockfile at $lock" >&2
  exit 1
fi

drift=0
while read -r name hash; do
  repo="$root/straight/repos/$name"
  if ! head="$(git -C "$repo" rev-parse HEAD 2>/dev/null)"; then
    echo "MISSING: $name (locked to $hash)"
    drift=1
    continue
  fi
  if [ "$head" != "$hash" ]; then
    echo "DRIFT: $name locked=$hash on-disk=$head"
    drift=1
  fi
done < <(grep -oE '\("[^"]+" \. "[0-9a-f]{40}"\)' "$lock" |
         sed -E 's/^\("([^"]+)" \. "([0-9a-f]{40})"\)$/\1 \2/')

if [ "$drift" -ne 0 ]; then
  echo ""
  echo "Straight repos do not match the lockfile."
  echo "Run 'M-x straight-freeze-versions' to re-freeze, or 'M-x straight-thaw-versions' to revert, then re-stage straight/versions/default.el."
  exit 1
fi
